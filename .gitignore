# Node / package manager
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.pnpm-debug.log

# Next.js build / output
.next/
out/
.build/
dist/

# Production
/.vercel
.vercel/
.now
.now/

# Appwrite / storage artifacts (if any)
# (no default artifacts here, change if you create local secrets/files)
# .appwrite/

# Environment variables (do NOT commit secrets)
.env
.env.*
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.*.secret
!.env.example

# Build caches, bundlers, tooling
.cache/
.parcel-cache/
.turbopack/
.turbo/
.eslintcache
.vscode/
.idea/

# TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Coverage / reports
coverage/
coverage-*/

# Temporary / misc
*.tmp
*.temp
*.swp
*.swo

# Images and large files you don't want to commit
*.psd
*.ai
*.sketch

# Sonner/toaster or other temp files - adjust as needed
*.local

# Optional: ignore lockfile if you prefer not to commit it (I recommend keeping it)
# package-lock.json
# yarn.lock
